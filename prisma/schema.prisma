// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Puja {
  id          String   @id @default(uuid())
  title       String
  tag         String
  date        String
  location    String
  benefits    String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([title])
  @@index([tag])
  @@index([date])
}